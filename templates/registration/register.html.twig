{% extends 'base.html.twig' %}

{% block title %}Create Account | MealPlanner{% endblock %}

{% block body %}
    <div class="auth-shell mx-auto">
        <div class="text-center mb-4">
            <i class="bi bi-egg-fried display-5 text-dark" aria-hidden="true"></i>
            <h1 class="h2 fw-bold mt-2">Create your account</h1>
            <p class="text-secondary mb-0">Start saving recipes and planning your week.</p>
        </div>

        <div class="card content-card">
            <div class="card-body p-4 p-md-5">
                {{ form_start(registrationForm) }}
                    {{ form_errors(registrationForm) }}
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(registrationForm.firstName) }}</div>
                        <div class="col-sm-6">{{ form_row(registrationForm.lastName) }}</div>
                        <div class="col-12">{{ form_row(registrationForm.email) }}</div>
                        <div class="col-12">{{ form_row(registrationForm.plainPassword, {label: 'Password', help: 'Use at least 6 characters.'}) }}</div>
                        <div class="col-12">{{ form_row(registrationForm.agreeTerms, {label: 'I agree to the terms'}) }}</div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 mt-2">Register</button>
                {{ form_end(registrationForm) }}
            </div>
        </div>
        <p class="text-center text-secondary mt-3 mb-0">Already have an account? <a href="{{ path('app_login') }}" class="link-success fw-semibold">Sign in</a></p>
    </div>
{% endblock %}