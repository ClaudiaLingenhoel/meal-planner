{% extends '@EasyAdmin/layout.html.twig' %}

{% block main %}
    <div class="container-fluid py-3 py-lg-4">
        <div class="mb-4">
            <span class="text-success fw-semibold text-uppercase small">Administration</span>
            <h1 class="h2 mb-2">MealPlanner Admin</h1>
            <p class="text-muted mb-0">Manage users, recipes and weekly meal plans.</p>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-4">
                <a href="{{ path('admin_user_index') }}" class="card h-100 text-decoration-none shadow-sm">
                    <div class="card-body p-4"><i class="fas fa-users fa-2x text-success mb-3"></i><h2 class="h5 text-body">Users</h2><p class="text-muted mb-0">Create, edit, block and review customer accounts.</p></div>
                </a>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <a href="{{ path('app_recipe_index') }}" class="card h-100 text-decoration-none shadow-sm">
                    <div class="card-body p-4"><i class="fas fa-utensils fa-2x text-success mb-3"></i><h2 class="h5 text-body">Recipes</h2><p class="text-muted mb-0">Browse and manage recipes from every user.</p></div>
                </a>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <a href="{{ path('admin_planned_meal_index') }}" class="card h-100 text-decoration-none shadow-sm">
                    <div class="card-body p-4"><i class="fas fa-calendar-alt fa-2x text-success mb-3"></i><h2 class="h5 text-body">Meal plans</h2><p class="text-muted mb-0">Review what customers have planned for the week.</p></div>
                </a>
            </div>
        </div>
    </div>
{% endblock %}
