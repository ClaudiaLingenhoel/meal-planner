{% extends 'base.html.twig' %}

{% block title %}
    Recipe
{% endblock %}

{% block body %}
    <h1>Recipe</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ recipe.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ recipe.title }}</td>
            </tr>
            <tr>
                <th>CookingTimeMinutes</th>
                <td>{{ recipe.cookingTimeMinutes }}</td>
            </tr>
            <tr>
                <th>ShortDescription</th>
                <td>{{ recipe.shortDescription }}</td>
            </tr>
            <tr>
                <th>Instructions</th>
                <td>{{ recipe.instructions }}</td>
            </tr>

            <tr>
                <th>Ingredients</th>
                <td>
                    <ul>
                        {% for recipeIngredient in recipe.recipeIngredients %}
                            <li>
                                {% if recipeIngredient.quantity is not null %}
                                    {{ recipeIngredient.quantity }}
                                {% endif %}

                                {{ recipeIngredient.unit }}

                                {{ recipeIngredient.ingredient.name }}

                                {% if recipeIngredient.specification %}
                                    ({{ recipeIngredient.specification }})
                                {% endif %}
                            </li>
                        {% else %}
                            <li>No ingredients added.</li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>

            <tr>
                <th>Source</th>
                <td>{{ recipe.source }}</td>
            </tr>
            <tr>
                <th>Servings</th>
                <td>{{ recipe.servings }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ recipe.image }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ recipe.createdAt ? recipe.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ recipe.updatedAt ? recipe.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_recipe_index') }}">back to list</a>

    <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}">edit</a>

    {{ include('recipe/_delete_form.html.twig') }}
{% endblock %}
