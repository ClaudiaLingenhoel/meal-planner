{% extends 'base.html.twig' %}

{% block title %}Edit {{ recipe.title }} | MealPlanner{% endblock %}

{% block body %}
    <div class="form-shell mx-auto">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div class="page-heading">
                <span class="text-success fw-semibold text-uppercase small">Recipe settings</span>
                <h1 class="display-6 fw-bold mb-2">Edit {{ recipe.title }}</h1>
                <p class="text-secondary mb-0">Update the recipe details, ingredients or image.</p>
            </div>
            <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" class="btn btn-outline-secondary flex-shrink-0">View recipe</a>
        </div>

        {{ include('recipe/_form.html.twig', {'button_label': 'Update'}) }}

        <div class="card border-danger mt-4">
            <div class="card-body d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div>
                    <h2 class="h6 mb-1">Delete this recipe</h2>
                    <p class="text-secondary small mb-0">This also removes it from any meal plans.</p>
                </div>
                {{ include('recipe/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
