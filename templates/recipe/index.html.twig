{% extends 'base.html.twig' %}

{% block title %}
    Recipes
{% endblock %}

{% block body %}
    <h1>{{ pageTitle }}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Minutes</th>
                <th>Description</th>
                <th>Servings</th>
                <th>Source</th>
                <th>Created</th>
                <th>Updated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for recipe in recipes %}
                <tr>
                    <td>{{ recipe.id }}</td>
                    <td>{{ recipe.title }}</td>
                    <td>{{ recipe.cookingTimeMinutes }}</td>
                    <td>{{ recipe.shortDescription }}</td>
                    <td>{{ recipe.servings }}</td>
                    <td>{{ recipe.source }}</td>
                    <td>{{ recipe.createdAt ? recipe.createdAt|date('d.m.Y H:i') : '' }}</td>
                    <td>{{ recipe.updatedAt ? recipe.updatedAt|date('d.m.Y H:i') : '' }}</td>
                    <td>
                        <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}">Details</a>

                        {% if app.user %}
                            <a href="{{ path('app_meal_planner_add', {id: recipe.id}) }}" class="btn btn-primary">
                                Add to meal planner
                            </a>
                        {% endif %}

                        {% if app.user and (recipe.creator == app.user or is_granted('ROLE_ADMIN')) %}
                            <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}">
                                Edit
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="11">no records found</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_recipe_new') }}">Create new</a>
    {% endif %}

{% endblock %}
