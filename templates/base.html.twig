<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}MealPlanner{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
        {% block stylesheets %}
        {% endblock %}
    </head>

    <body>
        <header>
            <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
                <div class="container">

                    <!-- nav brand -->
                    <a class="navbar-brand fw-bold" href="{{ path('app_recipe_index') }}">
                        <i class="bi bi-egg-fried"></i> MealPlanner
                    </a>

                    <!-- hamburger button -->
                    <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                    <i class="bi bi-egg"></i></button>

                    <!-- nav links -->
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                            {% if is_granted('IS_AUTHENTICATED_FULLY') %}

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_recipe_index') }}">All Recipes</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_recipe_mine') }}">My Recipes</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_recipe_new') }}">Add a Recipe</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_meal_planner_index') }}">Weekly Plan</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_profile_index') }}">Profile</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                                </li>

                            {% else %}

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_register') }}">Register</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                                </li>

                            {% endif %}

                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main>
            <div class="container my-5">

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}

                {% block body %}
                {% endblock %}

            </div>
        </main>

        <footer class="mt-5">
            <div class="container text-center">
                &copy; {{ 'now'|date('Y') }} <i class="bi bi-egg-fried"></i> MealPlanner
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

    </body>
</html>



