<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}MealPlanner{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

    </head>

    <body class="d-flex flex-column min-vh-100">
        <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-light" href="#main-content">Skip to content</a>
        <header>
            {% set currentRoute = app.request.attributes.get('_route') %}
            <nav class="navbar navbar-expand-lg bg-white" aria-label="Main navigation">
                <div class="container">

                    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('app_recipe_index') }}">
                        <i class="bi bi-egg-fried" aria-hidden="true"></i>
                        <span>MealPlanner</span>
                    </a>

                    <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span></button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-1">

                            {% if is_granted('IS_AUTHENTICATED_FULLY') %}

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_recipe_index' ? ' active' : '' }}" href="{{ path('app_recipe_index') }}">All Recipes</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_recipe_mine' ? ' active' : '' }}" href="{{ path('app_recipe_mine') }}">My Recipes</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_recipe_new' ? ' active' : '' }}" href="{{ path('app_recipe_new') }}">Add Recipe</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute starts with 'app_meal_planner_' ? ' active' : '' }}" href="{{ path('app_meal_planner_index') }}">Weekly Plan</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_shopping_list' ? ' active' : '' }}" href="{{ path('app_shopping_list') }}" data-turbo="false">Shopping List</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute starts with 'app_profile_' ? ' active' : '' }}" href="{{ path('app_profile_index') }}">Profile</a>
                                </li>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('admin') }}" data-turbo="false">
                                            Admin
                                        </a>
                                    </li>
                                {% endif %}

                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_logout') }}" data-turbo="false" data-turbo-prefetch="false"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Logout</a>
                                </li>

                            {% else %}

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_recipe_index' ? ' active' : '' }}" href="{{ path('app_recipe_index') }}">All Recipes</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_register' ? ' active' : '' }}" href="{{ path('app_register') }}">Register</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link{{ currentRoute == 'app_login' ? ' active' : '' }}" href="{{ path('app_login') }}" data-turbo="false">Login</a>
                                </li>

                            {% endif %}

                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main id="main-content" class="flex-grow-1">
            <div class="{% block main_container_class %}container{% endblock %} py-4 py-lg-5">

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>{{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}

                {% block body %}
                {% endblock %}

            </div>
        </main>

        <footer class="border-top bg-white py-4 mt-auto">
            <div class="container text-center text-secondary small">
                &copy; {{ 'now'|date('Y') }} <i class="bi bi-egg-fried text-success" aria-hidden="true"></i> MealPlanner
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    </body>
</html>
