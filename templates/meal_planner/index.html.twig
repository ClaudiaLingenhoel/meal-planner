{% extends 'base.html.twig' %}

{% block title %}
    Weekly Meal Planner
{% endblock %}

{% block body %}

    {% set weekDays = [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday'
    ] %}

    {% set mealTimes = ['breakfast', 'lunch', 'dinner', 'snack'] %}

    {% if adminView %}
        <div class="alert alert-info">
            Admin view: Weekly meal plan for {{ viewedUser.email }}
        </div>
    {% endif %}

    <h1>Weekly Meal Planner</h1>

    <p>{{ startOfWeek|date('d.m.Y') }} - {{ endOfWeek|date('d.m.Y') }}</p>

    {% if adminView %}
        <a href="{{ path('app_meal_planner_admin_view', {
            id: viewedUser.id,
            week: startOfWeek|date_modify('-7 days')|date('Y-m-d')
            }) }}">
            Previous Week
        </a>

        <a href="{{ path('app_meal_planner_admin_view', {id: viewedUser.id}) }}">
            Current Week
        </a>

        <a href="{{ path('app_meal_planner_admin_view', {
            id: viewedUser.id,
            week: startOfWeek|date_modify('+7 days')|date('Y-m-d')
            }) }}">
            Next Week
        </a>
    {% else %}

        <a href="{{ path('app_meal_planner_index', {
            week: startOfWeek|date_modify('-7 days')|date('Y-m-d')
            }) }}">
            Previous Week
        </a>

        <a href="{{ path('app_meal_planner_index') }}">
            Current Week
        </a>

        <a href="{{ path('app_meal_planner_index', {
            week: startOfWeek|date_modify('+7 days')|date('Y-m-d')
            }) }}">
            Next Week
        </a>
    {% endif %}

    <div class="weekly-planner">
        {% for i in 0..6 %}
            {% set currentDay = startOfWeek|date_modify('+' ~ i ~ ' days') %}

            <section class="day-column">
                <div class="day-header">
                    <h2>{{ currentDay|date('l') }}</h2>
                    <p>{{ currentDay|date('d.m.y') }}</p>
                </div>
                {% for mealTime in mealTimes %}
                    <div class="meal-slot">

                        <h3>{{ mealTime|capitalize }}</h3>

                        {% for plannedMeal in plannedMeals %}
                            {% if plannedMeal.scheduledFor|date('Y-m-d') == currentDay|date('Y-m-d') and plannedMeal.mealTime.value == mealTime %}

                                <div class="card mb-2">
                                    <div class="card-body p-2">

                                        <strong>{{ plannedMeal.recipe.title }}</strong>

                                        {% if not adminView %}
                                            <div class="mt-2">
                                                <a href="{{ path('app_meal_planner_edit', {'id': plannedMeal.id}) }}">
                                                    Edit
                                                </a>

                                                {{ include('meal_planner/_delete_form.html.twig') }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </section>
        {% endfor %}
    </div>
{% endblock %}