{{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="row g-3">
        <div class="col-md-4">{{ form_row(form.scheduledFor) }}</div>
        <div class="col-md-4">{{ form_row(form.mealTime) }}</div>
        <div class="col-md-4">{{ form_row(form.servings) }}</div>
    </div>
    <button class="btn btn-success mt-2"><i class="bi bi-calendar-check me-1" aria-hidden="true"></i>{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
