<form method="post" action="{{ path('app_meal_planner_delete', {'id': plannedMeal.id}) }}" onsubmit="return confirm('Are you sure you want to remove this item from your planner?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plannedMeal.id) }}">
    <button class="btn">Remove</button>
</form>
