{% extends 'base.html.twig' %}

{% block title %}
    Edit Profile
{% endblock %}

{% block body %}

    <h1>Edit Profile</h1>

    {{ form_start(form) }}

    {{ form_row(form.firstName) }}
    {{ form_row(form.lastName) }}
    {{ form_row(form.email) }}
    {{ form_row(form.dietaryType) }}

    <button type="submit" class="btn btn-primary">Save</button>

    {{ form_end(form) }}
{% endblock %}

