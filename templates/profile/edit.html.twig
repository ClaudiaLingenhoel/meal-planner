{% extends 'base.html.twig' %}

{% block title %}Edit Profile | MealPlanner{% endblock %}

{% block body %}
    <div class="auth-shell mx-auto">
        <div class="page-heading mb-4">
            <span class="text-success fw-semibold text-uppercase small">Account</span>
            <h1 class="display-6 fw-bold mb-2">Edit profile</h1>
            <p class="text-secondary mb-0">Update your name or dietary preference.</p>
        </div>
        <div class="card content-card">
            <div class="card-body p-4">
                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.dietaryType) }}
                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                        <button type="submit" class="btn btn-success">Save</button>
                        <a href="{{ path('app_profile_index') }}" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
